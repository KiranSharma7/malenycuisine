# Allowlist .gitignore
# Rule: ignore EVERYTHING first, then let back in only the site code + assets.
# Order matters: the "*" line must come first, and a folder must be
# un-ignored before Git will look at the files inside it.

# 1. Ignore everything in the project.
*

# 2. Let the site code back in.
!index2.html
!styles.css
!script.js

# 3. Let the assets folder and everything inside it back in.
!assets/
!assets/**

# 4. Keep this file itself tracked.
!.gitignore

# Intentionally NOT tracked (covered by the "*" rule above):
#   README.md, DESIGN.md, PRODUCT.md
#   content/, design-references/
#   .claude/, .agents/, .codex/, .impeccable/
# These are local docs and tool folders, not part of the shipped site.

# impeccable-live-ignore-start
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/config.local.json
.impeccable/live/server.json
.impeccable/live/roots.json
.impeccable/live/app-root.json
.impeccable/live/inject-journal.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/artifacts/
.impeccable/live/accept-receipts/
.impeccable/live/locks/
.impeccable/live/cache/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable-live.json
.impeccable-live/
app/.impeccable-live/
src/.impeccable-live/
node_modules/.impeccable-live/
src/lib/impeccable/ImpeccableLiveRoot.svelte
src/lib/impeccable/__runtime.js
src/lib/impeccable/[0-9a-f]*/
plugins/impeccable-live.client.ts
app/plugins/impeccable-live.client.ts
src/plugins/impeccable-live.client.ts
# impeccable-live-ignore-end
